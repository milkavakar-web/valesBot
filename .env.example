# Скопируйте этот файл в .env и заполните

# Веб-панель
HOST=127.0.0.1
PORT=8000
PANEL_USER=admin
# Обязателен, если HOST не 127.0.0.1 (например, в Docker)
PANEL_PASSWORD=
# Если открываете панель не через localhost/127.0.0.1 (по IP сервера или домену),
# перечислите эти адреса через запятую, иначе панель ответит «403»
PANEL_HOSTS=

# Загружать сигналы-скрипты из панели, открытой не с этого компьютера. Скрипт выполняется
# со всеми правами программы, поэтому включайте, только если панель защищена паролем
ALLOW_SCRIPTS=0

# Как часто бот проверяет цену, секунд
POLL_SECONDS=15

# Демо-счёт Binance: https://demo.binance.com → API Management
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=

# Реальный счёт. Права ключа: только чтение и торговля (спот и/или фьючерсы).
# Вывод средств НЕ включайте. Привяжите ключ к IP вашего сервера.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Реальная торговля включается только этим флагом
ALLOW_LIVE=0

# Уведомления в Telegram (как подключить — кнопка «Telegram» в панели или README).
# Токен бота от @BotFather храните только здесь.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 0 — не присылать сообщения о бумажных ботах
TELEGRAM_PAPER=1
